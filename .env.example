
# ==================================================
# CS4371 Group Project 1 - Environment Configuration
# ==================================================
# Copy this file to .env and customize as needed.
# Do not commit .env to GitHub.


# --------------------------------------------------
# Docker Compose
# --------------------------------------------------
COMPOSE_PROJECT_NAME=cs4371-gp1

# Docker data storage (relative to project directory)
# Can be overridden with an absolute path in local .env
GP1_DATA_DIR=./docker-data


# --------------------------------------------------
# Apache Kafka
# --------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_INPUT_TOPIC=topic1
KAFKA_OUTPUT_TOPIC=topic2


# --------------------------------------------------
# Hacker News API
# --------------------------------------------------
HN_API_URL=https://hacker-news.firebaseio.com/v0
HN_POLL_INTERVAL=30
HN_MAX_ITEMS=30
HN_DURATION_MINUTES=60
HN_DATABASE=data/producer.db
DATA_OUTPUT=data/messages.jsonl


# --------------------------------------------------
# Part 1 - Named Entity Recognition
# --------------------------------------------------
ENTITY_DATABASE=data/entity_counts.db
ENTITY_CHECKPOINT_DIR=checkpoints/entity_stream


# --------------------------------------------------
# Part 2 - AG News Classification
# --------------------------------------------------
# Train the model first using part2/src/part2_train.py
GP1_MODEL_PATH=models/agnews_tfidf_lr


# --------------------------------------------------
# Spark Structured Streaming
# --------------------------------------------------
SPARK_MASTER=local[2]
SPARK_DRIVER_MEMORY=2g
SPARK_TRIGGER_SECONDS=10

# Spark Kafka connector (match your PySpark version)
SPARK_KAFKA_PACKAGE=org.apache.spark:spark-sql-kafka-0-10_2.13:4.1.3

# Spark networking (local single-machine setup)
# Change these when running Spark across multiple machines.
SPARK_LOCAL_IP=127.0.0.1
SPARK_DRIVER_HOST=127.0.0.1
SPARK_DRIVER_BIND_ADDRESS=127.0.0.1

# --------------------------------------------------
# Elasticsearch
# --------------------------------------------------
ELASTICSEARCH_HOST=http://localhost:9200


# --------------------------------------------------
# Snapshot Configuration
# --------------------------------------------------
SNAPSHOT_DIR=outputs/snapshots
SNAPSHOT_INTERVAL_MINUTES=15
SNAPSHOT_COUNT=4
